{
  "name": "@volontariapp/domain-social",
  "version": "0.14.21",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Volontariapp/npm-packages.git"
  },
  "description": "Domain social services and repositories for Volontariapp",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "prepublishOnly": "yarn build",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src/",
    "test": "node --experimental-vm-modules $(yarn bin jest)",
    "test:integration": "node --experimental-vm-modules $(yarn bin jest) --config jest.integration.config.js --runInBand",
    "test:all": "yarn test && yarn test:integration",
    "test:watch": "node --experimental-vm-modules $(yarn bin jest) --watch",
    "test:coverage": "node --experimental-vm-modules $(yarn bin jest) --coverage --coverageReporters=\"text\" --coverageReporters=\"json-summary\" --coverageReporters=\"lcov\" --coverageReporters=\"json\"",
    "test:coverage:integration": "node --experimental-vm-modules $(yarn bin jest) --config jest.integration.config.js --coverage --coverageReporters=\"text\" --coverageReporters=\"json-summary\" --coverageReporters=\"lcov\" --coverageReporters=\"json\" --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/typeorm": "^11.0.3",
    "@volontariapp/bridge-nest": "workspace:*",
    "@volontariapp/contracts": "workspace:*",
    "@volontariapp/database": "workspace:*",
    "@volontariapp/errors": "workspace:*",
    "@volontariapp/errors-nest": "workspace:*",
    "@volontariapp/logger": "workspace:*",
    "@volontariapp/messaging": "workspace:*",
    "@volontariapp/outbox": "workspace:*",
    "@volontariapp/shared": "workspace:*",
    "neo4j-driver": "^6.2.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@volontariapp/testing": "workspace:*",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "5.9.3"
  }
}
